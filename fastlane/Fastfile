# Example lanes. Set PGYER_API_KEY before running them, for example:
#   PGYER_API_KEY=your_api_key bundle exec fastlane upload_apk apk:app-release.apk

lane :upload_apk do |options|
  pgyer(apk: options[:apk], update_description: options[:update_description])
end

lane :upload_ipa do |options|
  pgyer(ipa: options[:ipa], update_description: options[:update_description])
end

lane :upload_hap do |options|
  pgyer(hap: options[:hap], update_description: options[:update_description])
end
